{
  "processes": [
    {
      "id": "settlement.tick",
      "mechanisms": [
        "settlement.infra.tick_scheduler",
        "settlement.expiry",
        "settlement.building.condition_decay",
        "settlement.business.staffing",
        "settlement.production.equipment_cap",
        "settlement.production.labour_cap",
        "settlement.production.constraint_Q",
        "settlement.wage.pay",
        "settlement.project.construction"
      ],
      "writes": [
        "settlement.status_changes",
        "settlement.condition",
        "settlement.post_filledby",
        "settlement.business.status",
        "settlement.labour.hours_assigned",
        "settlement.q_units_per_line_per_day",
        "settlement.production_record",
        "settlement.project.labour_hours",
        "settlement.new_changed_building_layout_version",
        "settlement.ticktrace"
      ],
      "reads": [
        "settlement.condition",
        "settlement.post_filledby"
      ],
      "period": 86400000,
      "phase": "day.settlement"
    }
  ],
  "ports": [
    {
      "mechanism": "settlement.business.staffing",
      "quantity": "contract.available_bool",
      "kind": "quantity",
      "unit": "1",
      "direction": "in"
    },
    {
      "mechanism": "settlement.business.staffing",
      "quantity": "contract.labour_hours_left",
      "kind": "quantity",
      "unit": "person*h",
      "direction": "in"
    },
    {
      "mechanism": "settlement.business.staffing",
      "quantity": "contract.labour_hours_granted",
      "kind": "quantity",
      "unit": "person*h",
      "direction": "in"
    },
    {
      "mechanism": "settlement.business.staffing",
      "quantity": "contract.labour_pool_grants",
      "kind": "record",
      "unit": null,
      "direction": "call"
    },
    {
      "mechanism": "settlement.project.construction",
      "quantity": "contract.labour_hours_granted",
      "kind": "quantity",
      "unit": "person*h",
      "direction": "in"
    },
    {
      "mechanism": "settlement.project.construction",
      "quantity": "contract.labour_pool_grants",
      "kind": "record",
      "unit": null,
      "direction": "call"
    },
    {
      "mechanism": "settlement.production.labour_cap",
      "quantity": "contract.productivity_factor",
      "kind": "quantity",
      "unit": "1",
      "direction": "in"
    },
    {
      "mechanism": "settlement.production.equipment_cap",
      "quantity": "economy.unitsperfixtureday",
      "kind": "quantity",
      "unit": "count/(count*d)",
      "direction": "in"
    },
    {
      "mechanism": "settlement.production.labour_cap",
      "quantity": "economy.labourhoursperunit",
      "kind": "quantity",
      "unit": "person*h/count",
      "direction": "in"
    },
    {
      "mechanism": "settlement.production.constraint_Q",
      "quantity": "economy.output_units",
      "kind": "quantity",
      "unit": "count",
      "direction": "in"
    },
    {
      "mechanism": "settlement.production.constraint_Q",
      "quantity": "economy.inputs_consumed",
      "kind": "quantity",
      "unit": "count",
      "direction": "call"
    },
    {
      "mechanism": "settlement.production.constraint_Q",
      "quantity": "economy.outputs_and_byproducts_added",
      "kind": "quantity",
      "unit": "count",
      "direction": "call"
    },
    {
      "mechanism": "settlement.production.constraint_Q",
      "quantity": "economy.market_producedtoday",
      "kind": "quantity",
      "unit": "count",
      "direction": "call"
    },
    {
      "mechanism": "settlement.project.construction",
      "quantity": "contract.have",
      "kind": "quantity",
      "unit": "count",
      "direction": "in"
    },
    {
      "mechanism": "settlement.project.construction",
      "quantity": "economy.units_taken",
      "kind": "quantity",
      "unit": "count",
      "direction": "in"
    },
    {
      "mechanism": "settlement.project.construction",
      "quantity": "economy.stock_changes",
      "kind": "record",
      "unit": null,
      "direction": "call"
    },
    {
      "mechanism": "settlement.production.constraint_Q",
      "quantity": "contract.utility_capacity",
      "kind": "quantity",
      "unit": "count/d",
      "direction": "in"
    },
    {
      "mechanism": "settlement.authority.office_powers",
      "quantity": "government.office_may",
      "kind": "quantity",
      "unit": "1",
      "direction": "in"
    }
  ],
  "streams": []
}
